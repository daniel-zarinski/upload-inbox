# Timezone used for the YYYY-MM-DD folders
TZ=America/Edmonton

# Azure pull (upload-inbox-pull service). Values printed by azure/deploy.sh, see azure/LINKS.md
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# Optional: Home Assistant webhook to POST {"files":[...]} to after each pull that moved files.
# (The Azure-side Event Grid webhook is separate and lives in azure/.env, see README.)
HA_WEBHOOK_URL=
